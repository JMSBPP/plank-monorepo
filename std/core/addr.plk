import std::fixedbytes::bytes32;
import std::regions::{bytes, memory, keccak256};
import std::membytes::{membytes, membytes_new, membytes_from_ptr};
import std::option::{Option, Some, None, unwrap as option_unwrap};
import std::core::uint::{u160, is_uint, try_cast_uint, cast_uint, unsafe_from_u256 as unsafe_uint_from_u256};

const addr = struct {
    as_uint: u160,
};


const addr_eq = fn (a: addr, b: addr) bool {
    cast_addr(a, u256) == cast_addr(b, u256)
};

const addr_from_u256 = fn (raw: u256) addr {
    let res = try_cast_uint(raw, u160);
    if !res.is_some {
        if @in_comptime() {
            @compile_error("address value exceeds 160 bits");
        } else {
            @evm_revert(@malloc_uninit(0), 0);
        }
    }
    addr { as_uint: res.inner }
};

/// Safety: `raw` must be a valid 160-bit value.
const unsafe_from_u256 = fn (raw: u256) addr {
    addr { as_uint: unsafe_uint_from_u256(u160, raw) }
};

const cast_addr = fn (this: addr, comptime Dst: type) Dst {
    if comptime { !is_uint(Dst) } {
        @compile_error("cast_addr: `Dst` not `uN` type");
    }
    cast_uint(this.as_uint, Dst)
};

const msg_sender = fn () addr {
    addr { as_uint: unsafe_uint_from_u256(u160, @evm_caller()) }
};

const tx_origin = fn () addr {
    addr { as_uint: unsafe_uint_from_u256(u160, @evm_origin()) }
};

const raw_create = fn (value: u256, code: bytes(memory)) Option(addr) {
    let account = @evm_create(value, code.ptr, code.length);
    if account == 0 {
        return None(addr);
    }
    Some(addr { as_uint: unsafe_uint_from_u256(u160, account) })
};

const raw_create2 = fn (value: u256, code: bytes(memory), salt: bytes32) Option(addr) {
    let account = @evm_create2(value, code.ptr, code.length, salt.raw);
    if account == 0 {
        return None(addr);
    }
    Some(addr { as_uint: unsafe_uint_from_u256(u160, account) })
};

// CREATE2 address pre-image: keccak256(0xff ++ deployer(20) ++ salt(32) ++ initCodeHash(32))[12:32]
const compute_create2_address = fn (deployer: addr, salt: bytes32, init_code_hash: bytes32) addr {
    let buf = membytes_new(85);
    @mstore8(buf.ptr, 0xff);
    let deployer_word = membytes_new(32);
    @mstore32(deployer_word.ptr, cast_addr(deployer, u256));
    @mcopy(buf.ptr + 1, deployer_word.ptr + 12, 20);
    @mstore32(buf.ptr + 21, salt.raw);
    @mstore32(buf.ptr + 53, init_code_hash.raw);
    let digest = keccak256(membytes_from_ptr(buf.ptr, 85));
    addr_from_u256(digest.raw & 0xffffffffffffffffffffffffffffffffffffffff)
};
